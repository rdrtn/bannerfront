# Copie este arquivo para ".env" e ajuste. O arquivo .env não vai para o Git.

# Senha do PostgreSQL. Use só letras e números (ela entra numa URL de conexão).
DB_PASSWORD=troque-por-uma-senha-forte-so-letras-e-numeros

# Administrador inicial: criado na primeira inicialização, quando ainda não há nenhum usuário.
# Depois do primeiro acesso, troque a senha em "Minha conta" e crie os demais usuários em "Usuários".
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha-agora
ADMIN_NAME=Administrador

# Porta publicada no computador/servidor.
APP_PORT=3000

# Mude para "true" quando o sistema for acessado por HTTPS (cookie de sessão só trafega por HTTPS).
COOKIE_SECURE=false

# Horas até a sessão expirar sem uso.
SESSION_TTL_HOURS=12

# Só se houver proxy reverso na frente (ex.: nginx): "true" para respeitar X-Forwarded-For.
TRUST_PROXY=false

# Origens extras aceitas para alterar dados, separadas por vírgula (normalmente vazio).
# Exemplo: https://bannerfront.suaempresa.com.br
ALLOWED_ORIGINS=

# --- Só para desenvolvimento sem Docker (npm run dev:server) ---
# DATABASE_URL=postgres://bannerfront:senha@localhost:5432/bannerfront
# DATA_DIR=./data
